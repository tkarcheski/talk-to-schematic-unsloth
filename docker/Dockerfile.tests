# syntax=docker/dockerfile:1
# cspell:words PYTHONDONTWRITEBYTECODE PYTHONUNBUFFERED freefont ipafont noto tlwg loma unifont zenhei
# cspell:ignoreRegExp /lib[a-z]+[0-9+.-]*/g
# The image contains public test tools only. Source, Git, datasets and credentials are never copied into it.
ARG PYTHON_IMAGE=python:3.13-slim-bookworm@sha256:a1165e272e578941b84abc79e4ab38a0305cd12803a5c4247979ac7655f4d641
ARG NODE_IMAGE=node:24-bookworm-slim@sha256:c86ecead9e55a5210ac1727de38a4ca840bf03dcaf34dc9749addbf383b1920c
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.19@sha256:04d046b13e60d6bcec73cbc5e1cad25d680dea90c8573340950a0ac2d1aef424
FROM ${NODE_IMAGE} AS node
FROM ${UV_IMAGE} AS uv
FROM ${PYTHON_IMAGE}
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
COPY --from=uv /uv /usr/local/bin/uv
ENV PLAYWRIGHT_VERSION=1.63.0 PLAYWRIGHT_BROWSERS_PATH=/opt/playwright-browsers \
    UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_CACHE_DIR=/tmp/uv-cache \
    npm_config_cache=/tmp/npm-cache PRE_COMMIT_HOME=/tmp/pre-commit HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# Debian 12 Chromium libraries/fonts match Playwright's dependency list; librsvg renders source fixtures.
# Package installation is confined to image construction. Checks run as an unprivileged user below.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git librsvg2-bin libatomic1 libstdc++6 \
    fonts-freefont-ttf fonts-ipafont-gothic fonts-liberation fonts-noto-color-emoji \
    fonts-tlwg-loma-otf fonts-unifont fonts-wqy-zenhei xfonts-scalable \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 libcups2 \
    libdbus-1-3 libdrm2 libfontconfig1 libfreetype6 libgbm1 libglib2.0-0 \
    libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 libxdamage1 \
    libxext6 libxfixes3 libxkbcommon0 libxrandr2 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
# Pin the browser installer separately; CI checks it agrees with the repository's locked Playwright.
RUN npm install --prefix /opt/browser-installer --ignore-scripts --no-audit --no-fund "playwright@${PLAYWRIGHT_VERSION}" \
    && node /opt/browser-installer/node_modules/playwright/cli.js install chromium \
    && chmod -R a+rX /opt/playwright-browsers \
    && rm -rf /opt/browser-installer /tmp/npm-cache
USER 10001:10001
WORKDIR /workspace
CMD ["bash"]
