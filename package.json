{
  "name": "talk-to-schematic-development",
  "private": true,
  "description": "Repository spelling, formatting and browser checks; the application is a uv-managed Python package",
  "scripts": {
    "spellcheck": "cspell lint --no-progress --no-must-find-files --gitignore \"**/*.{md,py,yml,yaml,toml,js,mjs,css,html}\"",
    "format:check": "prettier --check \"schematic_model/web/*.{html,css,js,svg}\" \"scripts/*.mjs\"",
    "browser:smoke": "node scripts/browser_smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "cspell": "10.3.6",
    "prettier": "3.9.9"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
