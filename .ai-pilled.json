{
  "version": 1,
  "commands": {
    "test": [
      ".venv/bin/python",
      "-m",
      "coverage",
      "run",
      "--data-file=.ai-pilled/coverage",
      "-m",
      "pytest",
      "-q"
    ],
    "lint": [
      ".venv/bin/python",
      "-m",
      "ruff",
      "check",
      "."
    ],
    "coverage": [
      ".venv/bin/python",
      "-m",
      "coverage",
      "report",
      "--data-file=.ai-pilled/coverage"
    ],
    "deadcode": [
      ".venv/bin/python",
      "-m",
      "vulture",
      "schematic_model",
      "evaluate.py",
      "chat.py",
      "scripts",
      "tests",
      "--min-confidence",
      "80"
    ],
    "typecheck": [
      ".venv/bin/python",
      "-m",
      "mypy"
    ],
    "dependency": [
      ".venv/bin/python",
      "scripts/audit_dependencies.py"
    ]
  },
  "protected_branches": [
    "main",
    "master"
  ],
  "require_tests": true,
  "timeout": 900,
  "aggressiveness": "normal",
  "review_on_commit": true,
  "review_checks_on_commit": true,
  "audit_dependencies_on_change": true
}
